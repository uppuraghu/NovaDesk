OLLAMA_INPUT_COST_PER_MILLION=0
OLLAMA_OUTPUT_COST_PER_MILLION=0
UPLOAD_DIR=uploads
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=novadesk@localhost
SMTP_USE_TLS=false
FRONTEND_PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
